{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/heads/dev/crates/tauri-utils/schema.json",
  "productName": "Terse",
  "version": "1.3.3",
  "identifier": "com.pruneai.app",
  "build": {
    "frontendDist": "../../src/renderer"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../ml/model/complexity-vocab.json": "ml/complexity-vocab.json",
      "../../src/helpers/terse-compress.js": "terse-compress.js",
      "../helpers/terse-rewrite.ps1": "terse-rewrite.ps1",
      "../helpers/hooks/terse-hook-cursor.ps1": "hooks/terse-hook-cursor.ps1",
      "../helpers/hooks/terse-hook-cline.ps1": "hooks/terse-hook-cline.ps1",
      "../helpers/hooks/terse-hook-codex.ps1": "hooks/terse-hook-codex.ps1",
      "../helpers/hooks/terse-hook-copilot.ps1": "hooks/terse-hook-copilot.ps1",
      "../helpers/hooks/terse-hook-openclaw.ts": "hooks/terse-hook-openclaw.ts",
      "../helpers/hooks/terse-hook-windsurf.ps1": "hooks/terse-hook-windsurf.ps1",
      "../helpers/terse-optimize-tools.ps1": "terse-optimize-tools.ps1",
      "../helpers/hooks/terse-tool-optimizer-cursor.ps1": "hooks/terse-tool-optimizer-cursor.ps1",
      "../helpers/hooks/terse-tool-optimizer-codex.ps1": "hooks/terse-tool-optimizer-codex.ps1",
      "../helpers/hooks/terse-tool-optimizer-cline.ps1": "hooks/terse-tool-optimizer-cline.ps1",
      "../helpers/hooks/terse-tool-optimizer-windsurf.ps1": "hooks/terse-tool-optimizer-windsurf.ps1",
      "../helpers/hooks/terse-tool-optimizer-copilot.ps1": "hooks/terse-tool-optimizer-copilot.ps1",
      "../helpers/terse-uia.exe": "terse-uia.exe",
      "../../src/helpers/gf-live/engine.py": "gf-live/engine.py",
      "../../src/helpers/gf-live/gfmel.py": "gf-live/gfmel.py",
      "../../src/helpers/gf-live/sweet.py": "gf-live/sweet.py",
      "../../src/helpers/gf-live/stt.py": "gf-live/stt.py",
      "../../src/helpers/gf-live/bargein.py": "gf-live/bargein.py",
      "../../src/helpers/gf-live/breeze_lex.py": "gf-live/breeze_lex.py",
      "../../src/helpers/gf-live/agents.py": "gf-live/agents.py",
      "../../src/helpers/gf-live/asr.py": "gf-live/asr.py",
      "../../src/helpers/gf-live/melo_gpu.py": "gf-live/melo_gpu.py",
      "../../src/helpers/gf-live/tts_qwen.py": "gf-live/tts_qwen.py",
      "../../src/helpers/gf-live/setup.ps1": "gf-live/setup.ps1",
      "../../src/helpers/gf-live/NOTICE.md": "gf-live/NOTICE.md",
      "../../src/helpers/gf-live/duix/__init__.py": "gf-live/duix/__init__.py",
      "../../src/helpers/gf-live/duix/dh_video.py": "gf-live/duix/dh_video.py",
      "../../src/helpers/gf-live/duix/visemes.py": "gf-live/duix/visemes.py",
      "../../src/helpers/gf-live/duix/lipwarp.py": "gf-live/duix/lipwarp.py",
      "../../src/helpers/gf-live/duix/duix_audio.py": "gf-live/duix/duix_audio.py",
      "../../src/helpers/gf-live/duix/duix_face.py": "gf-live/duix/duix_face.py",
      "../../src/helpers/gf-live/duix/duix_hd.py": "gf-live/duix/duix_hd.py",
      "../../src/helpers/gf-live/duix/duix_mobile.py": "gf-live/duix/duix_mobile.py",
      "../../src/helpers/gf-live/duix/duix_guard.py": "gf-live/duix/duix_guard.py",
      "../../src/helpers/gf-live/duix/runner_client.py": "gf-live/duix/runner_client.py",
      "../../src/helpers/gf-live/duix/ort_runner.py": "gf-live/duix/ort_runner.py",
      "../../src/helpers/gf-live/duix/LICENSE-DUIX.COM.txt": "gf-live/duix/LICENSE-DUIX.COM.txt",
      "../../src/assets/gf-presets/char_mia/manifest.json": "gf-presets/char_mia/manifest.json",
      "../../src/assets/gf-presets/char_mia/poster.jpg": "gf-presets/char_mia/poster.jpg",
      "../../src/assets/gf-presets/NOTICE.md": "gf-presets/NOTICE.md"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Terse",
        "url": "splash.html",
        "width": 460,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "main",
        "title": "Terse",
        "url": "index.html",
        "width": 980,
        "height": 650,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "terse"
        ]
      }
    }
  }
}
