{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/heads/dev/crates/tauri-utils/schema.json",
  "productName": "Terse",
  "version": "1.3.3",
  "identifier": "com.pruneai.app",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "terse"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "macOS": {
      "entitlements": "../src-tauri/Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../ml/model/complexity-vocab.json": "ml/complexity-vocab.json",
      "../src/helpers/terse-ax": "terse-ax",
      "../src/helpers/terse-desk": "terse-desk",
      "../src/helpers/terse-hands": "terse-hands",
      "../src/helpers/terse-listen": "terse-listen",
      "../src/helpers/terse-compress.js": "terse-compress.js",
      "../src/helpers/terse-rewrite.sh": "terse-rewrite.sh",
      "../src/helpers/hooks/terse-hook-cursor.sh": "hooks/terse-hook-cursor.sh",
