      "../src/assets/gf-presets/NOTICE.md": "gf-presets/NOTICE.md",
      "../src/helpers/gf-live/engine.py": "gf-live/engine.py",
      "../src/helpers/gf-live/gfmel.py": "gf-live/gfmel.py",
      "../src/helpers/gf-live/tts_qwen.py": "gf-live/tts_qwen.py",
      "../src/helpers/gf-live/convert_w2l.py": "gf-live/convert_w2l.py",
      "../src/helpers/gf-live/w2l_model.py": "gf-live/w2l_model.py",
      "../src/helpers/gf-live/setup.sh": "gf-live/setup.sh",
      "../src/helpers/gf-live/terse-gf-lipsync": "gf-live/terse-gf-lipsync",
      "../src/helpers/gf-live/terse-gf-video": "gf-live/terse-gf-video",
