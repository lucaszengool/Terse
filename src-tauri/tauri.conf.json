      "../src/helpers/gf-live/voices/qingtian.spk": "gf-live/voices/qingtian.spk",
      "../src/helpers/gf-live/voices/qingtian.rvq": "gf-live/voices/qingtian.rvq",
      "../src/helpers/gf-live/voices/qingtian.txt": "gf-live/voices/qingtian.txt",
      "../src/helpers/gf-live/voices/wenrou.spk": "gf-live/voices/wenrou.spk",
      "../src/helpers/gf-live/voices/wenrou.rvq": "gf-live/voices/wenrou.rvq",
      "../src/helpers/gf-live/voices/wenrou.txt": "gf-live/voices/wenrou.txt"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "title": "Terse",
        "url": "splash.html",
        "width": 460,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "main",
        "title": "Terse",
        "url": "index.html",
        "width": 980,
        "height": 650,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  }
}
